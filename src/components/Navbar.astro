<style is:global>
  /* Applied for one frame while the theme flips so colors snap instead of animating. */
  html.no-transitions *,
  html.no-transitions *::before,
  html.no-transitions *::after {
    transition: none !important;
  }
</style>

<style>
  /* Motion tokens from design-engineering/animation-recipes.md. */
  #mobile-nav-view,
  #mobile-menu-button,
  #theme-button {
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1); /* house curve: enters, exits, responses */
    --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1); /* sheet curve */
  }

  /* The panel is a full-width sheet sliding in from the hamburger's side. Transitions (not keyframes)
     so a second tap mid-slide retargets instead of restarting. Durations follow the drawer recipe
     (400ms) with a shorter exit; the travel is the full viewport width. `visibility` keeps the
     off-screen links out of the tab order and flips after the exit finishes. */
  #mobile-nav-view {
    --open: 400ms;
    --close: 300ms;
    transform: translateX(-100%);
    visibility: hidden;
    transition:
      transform var(--close) var(--ease-drawer),
      visibility 0s linear var(--close);
  }
  #mobile-nav-view[data-open] {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform var(--open) var(--ease-drawer),
      visibility 0s;
  }

  /* Items enter as a short stagger (occasional group, stagger recipe) and leave together, faster.
     The wrapper animates so the link keeps its own hover opacity. */
  .mobile-nav-item {
    opacity: 0;
    transform: translateX(-12px);
    transition:
      opacity 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }
  #mobile-nav-view[data-open] .mobile-nav-item {
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
  }
  #mobile-nav-view[data-open] .mobile-nav-item:nth-child(1) {
    transition-delay: 60ms;
  }
  #mobile-nav-view[data-open] .mobile-nav-item:nth-child(2) {
    transition-delay: 100ms;
  }
  #mobile-nav-view[data-open] .mobile-nav-item:nth-child(3) {
    transition-delay: 140ms;
  }

  .keep {
    display: grid !important;
  }

  .calc-top {
    padding-top: calc(50px + 5.25rem);
  }

  /* Press feedback (button-press recipe) on both nav buttons. Opacity hover comes from the utility classes. */
  #mobile-menu-button,
  #theme-button {
    transition:
      opacity 150ms ease,
      transform 160ms var(--ease-out);
  }
  #mobile-menu-button:active,
  #theme-button:active {
    transform: scale(0.97);
  }

  /* Hamburger -> X as a transform-only morph. Both bars sit at top: 0 and are offset with translateY,
     so the only thing that changes between states is the transform list, with a fixed origin.
     The two transform lists have the same shape so the browser interpolates each function directly. */
  .hamburger-lines {
    position: relative;
    display: block;
    transition: background-color 150ms ease;
  }
  .hamburger-lines::before,
  .hamburger-lines::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 1.25rem;
    height: 2px;
    transform-origin: center;
    transition: transform 150ms var(--ease-out);
  }
  .hamburger-lines::before {
    transform: translateY(7px) rotate(0deg);
  }
  .hamburger-lines::after {
    transform: translateY(-7px) rotate(0deg);
  }
  .rotate .hamburger-lines {
    background-color: transparent;
  }
  .rotate .hamburger-lines::before {
    transform: translateY(0) rotate(-45deg);
  }
  .rotate .hamburger-lines::after {
    transform: translateY(0) rotate(45deg);
  }

  /* Reduced motion is gentler, not zero: the panel fades instead of sliding, items fade without the
     stagger, the bars snap into the X while the middle bar still fades. */
  @media (prefers-reduced-motion: reduce) {
    #mobile-nav-view {
      transform: none;
      opacity: 0;
      transition:
        opacity 200ms var(--ease-out),
        visibility 0s linear 200ms;
    }
    #mobile-nav-view[data-open] {
      opacity: 1;
      transition:
        opacity 200ms var(--ease-out),
        visibility 0s;
    }
    .mobile-nav-item,
    #mobile-nav-view[data-open] .mobile-nav-item {
      transform: none;
      transition: opacity 200ms var(--ease-out);
      transition-delay: 0ms;
    }
    #mobile-menu-button:active,
    #theme-button:active {
      transform: none;
    }
    .hamburger-lines::before,
    .hamburger-lines::after {
      transition: none;
    }
  }
</style>

<nav class="gap-4 flex justify-between items-center lt-xs:px-4 px-8 my-10 md:mb-16 max-w-3xl mx-auto">
  <button
    id="mobile-menu-button"
    class="z-50 xs:hidden w-10 h-10 -ml-3 grid items-center justify-center rounded opacity-60 @hover:opacity-100"
    type="button"
    aria-label="Open navigation"
    aria-controls="main-navigation"
    aria-expanded="false"
  >
    <!--match icon color with others (from layout)-->
    <span class="hamburger-lines w-5 h-[2px] bg-stone-700 dark:bg-stone-200 before:bg-stone-700 before:dark:bg-stone-200 after:bg-stone-700 after:dark:bg-stone-200"></span>
  </button>
  <div class="hidden xs:flex items-center gap-12">
    <a href="/" title="Home" class="opacity-60 @hover:opacity-100 transition-opacity duration-150 ease">
      Home
    </a>
    <a href="/blog" title="Blog" class="opacity-60 @hover:opacity-100 transition-opacity duration-150 ease">
      Blog
    </a>
    <a href="/projects" title="Projects" class="opacity-60 @hover:opacity-100 transition-opacity duration-150 ease">
      Projects
    </a>
  </div>
  <button
    title="Theme"
    aria-label="Toggle dark mode"
    id="theme-button"
    class="z-50 text-base grid items-center justify-center w-10 h-10 -mr-3 rounded opacity-60 @hover:opacity-100 relative before:content-empty before:absolute before:-inset-0.5"
  >
    <div class="i-tabler-sun-filled dark:i-tabler-moon"></div>
  </button>
</nav>

<div
  id="mobile-nav-view"
  class="calc-top h-[100%] w-[100%] text-3xl fixed z-40 inset-0 flex gap-12 flex-col items-center bg-stone-100 dark:text-stone-100 dark:bg-stone-900 px-8"
>
  <div id="mobile-nav-items-selector" class="flex flex-col gap-12">
    <div class="mobile-nav-item">
      <a href="/" title="Home" class="opacity-60 @hover:opacity-100 transition-opacity duration-150 ease">
        Home
      </a>
    </div>
    <div class="mobile-nav-item">
      <a href="/blog" title="Blog" class="opacity-60 @hover:opacity-100 transition-opacity duration-150 ease">
        Blog
      </a>
    </div>
    <div class="mobile-nav-item">
      <a href="/projects" title="Projects" class="opacity-60 @hover:opacity-100 transition-opacity duration-150 ease">
        Projects
      </a>
    </div>
  </div>
</div>

<script is:inline>
  // Immediately Invoked Function Expression
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
    return 'light';
  })();

  // Set the theme on the root element
  // Flip the theme without animating every color transition on the page.
  function withoutTransitions(fn) {
    const root = document.documentElement;
    root.classList.add('no-transitions');
    fn();
    // Force a style flush so the class takes effect before it's removed.
    void root.offsetWidth;
    requestAnimationFrame(() => root.classList.remove('no-transitions'));
  }

  function applyTheme(theme) {
    withoutTransitions(() => {
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    });
    window.localStorage.setItem('theme', theme);
  }

  applyTheme(theme);

  const handleToggleClick = () => {
    const element = document.documentElement;
    withoutTransitions(() => element.classList.toggle('dark'));

    const isDark = element.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  const themeButton = document.getElementById('theme-button');

  if (themeButton) {
    themeButton.addEventListener('click', handleToggleClick);
  }

  // Update the theme if the system preference changes and 'system' is selected
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    applyTheme(event.matches ? 'dark' : 'light');
  });
</script>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileNavView = document.getElementById('mobile-nav-view');

  if (menuButton && mobileNavView) {
    const setOpen = (open: boolean) => {
      // `keep` holds the button visible if the viewport grows past the breakpoint while the menu is open.
      menuButton.classList.toggle('keep', open);
      menuButton.classList.toggle('rotate', open);
      menuButton.setAttribute('aria-expanded', String(open));
      mobileNavView.toggleAttribute('data-open', open);
      if (!open) document.body.style.overflow = '';
    };

    menuButton.addEventListener('click', () => {
      setOpen(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !mobileNavView.hasAttribute('data-open')) return;
      setOpen(false);
      menuButton.focus();
    });

    // Lock page scroll only once the panel has fully covered the page, so dropping the scrollbar
    // can't shift the layout mid-slide. If the menu is closed before the slide finishes, this never
    // fires and the body stays scrollable, which is the right state.
    mobileNavView.addEventListener('transitionend', (event) => {
      if (event.target !== mobileNavView) return;
      if (event.propertyName !== 'transform' && event.propertyName !== 'opacity') return;
      if (mobileNavView.hasAttribute('data-open')) document.body.style.overflow = 'hidden';
    });
  }
</script>

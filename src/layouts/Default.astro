---
import CommonHead from '@components/CommonHead.astro';
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  tumblrRedir?: boolean;
}

const { title, description, image, tumblrRedir } = Astro.props;
---

<html lang="en" class="scroll-pt-8">
  <CommonHead title={title} description={description} image={image} tumblrRedir={tumblrRedir} />
  <body class="antialiased font-sans text-lg text-stone-600 bg-stone-100 dark:text-stone-300 dark:bg-stone-900">
    <Navbar />
    <main class="px-8 lt-xs:px-4 max-w-3xl mx-auto">
      <!-- content is injected here -->
      <slot />
    </main>
    <Footer />
    <style is:global>
      /* Reserve gutter for scrollbar so nav doesn't shift on pages with/without scroll. */
      html {
        scrollbar-gutter: stable;
      }
      /* Prevent horizontal page scroll from carousel overflow, without clipping visible previews. */
      body {
        overflow-x: clip;
      }
    </style>
  </body>
</html>
